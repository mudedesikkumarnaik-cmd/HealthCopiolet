# Firebase Authentication + Firestore (real accounts).
# Copy this file to `.env` and fill in values from your Firebase console
# (Project settings → General → Your apps → Web app → SDK setup and configuration).
# The web API key is public by design — it only identifies your project.
# Do NOT commit the real `.env` file.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_PROJECT_ID=

# Optional: remote AI provider (server-side endpoint only — never ship keys).
# VITE_AI_PROVIDER=remote
# VITE_AI_ENDPOINT=https://your-server.example.com/ask
# VITE_AI_MODEL=your-model-name